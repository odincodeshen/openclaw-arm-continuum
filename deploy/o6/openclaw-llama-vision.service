# llama.cpp vision model for OpenClaw on an Orion O6 -- only needed when the
# main model can't read images (two-model setup). See openclaw-llama-main.service.
[Unit]
Description=OpenClaw llama.cpp vision model
After=network-online.target

[Service]
EnvironmentFile=%h/.config/openclaw-o6-models.env
ExecStart=/bin/sh -c 'exec "$LLAMA_SERVER" -m "$VISION_MODEL" --mmproj "$VISION_MMPROJ" --alias o6-vision --jinja -c "$VISION_CTX" -t "$THREADS" --cache-ram "$${VISION_CACHE_RAM:-512}" --host "$BIND_HOST" --port 8081'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
