# Models for the OpenClaw llama.cpp services on an Orion O6.
# Copy to ~/.config/openclaw-o6-models.env and restart the services after a change:
#   systemctl --user restart openclaw-llama-main openclaw-llama-vision
LLAMA_SERVER=/home/radxa/ernie_lp/llama.cpp/build_v9_on/bin/llama-server
BIND_HOST=172.17.0.1
THREADS=8

# Prompt cache (host RAM). llama.cpp keeps recent prompts so a request that
# starts the same way (persona, history) skips re-reading that part. Its
# default limit is 8 GiB, more than the O6 has spare; about 55 KiB per token
# with ERNIE, so 2 GiB holds ~38k tokens of prompts.
MAIN_CACHE_RAM=2048
VISION_CACHE_RAM=512
# How much of a new prompt must match a slot's last prompt to reuse that
# slot. llama.cpp's default (0.10) sends a long /rag prompt -- which shares
# only the ~150-token persona -- to an empty slot, so nothing is reused.
SLOT_SIMILARITY=0.01

# Candidate A: one multimodal model (text + vision) -- set MAIN_MMPROJ, don't
# start openclaw-llama-vision, and point OPENCLAW_VLM_BASE_URL at :8080.
#MAIN_MODEL=/home/radxa/models/qwen3-vl/Qwen3-VL-30B-A3B-Instruct-Q4_K_M.gguf
#MAIN_MMPROJ=/home/radxa/models/qwen3-vl/mmproj-Qwen3-VL-30B-A3B-Instruct-F16.gguf

# Candidate B: a text model + a separate vision model on :8081.
MAIN_MODEL=/home/radxa/models/ernie-4.5/ERNIE-4.5-21B-A3B-PT-Q4_0.gguf
MAIN_MMPROJ=
MAIN_CTX=16384
VISION_MODEL=/home/radxa/workspace/model_dir/Qwen2-VL-7B-Instruct-GGUF/Qwen2-VL-7B-Instruct-Q4_K_M.gguf
VISION_MMPROJ=/home/radxa/workspace/model_dir/Qwen2-VL-7B-Instruct-GGUF/Qwen2-VL-7B-Instruct-Vision.gguf
VISION_CTX=8192
