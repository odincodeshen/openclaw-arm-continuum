# Settings to add to each bot's profiles/<bot>/.env on a Radxa Orion O6
# (Arm CPU-only), on top of the usual bot settings -- see docs/O6_SETUP.md.
# The bots run from compose.persona.<bot>.yaml made from
# compose.persona.o6.example.yaml; llama.cpp, Ollama and Qdrant run on the host.

# Model: llama.cpp on the host. With one multimodal model (Qwen3-VL-30B-A3B)
# text and vision use the same server; with two models point the VLM at the
# second one (e.g. :8081).
OPENCLAW_VLLM_BASE_URL=http://host.docker.internal:8080/v1
OPENCLAW_VLLM_MODEL=o6-main
OPENCLAW_VISION_ENABLED=true
OPENCLAW_VLM_BASE_URL=http://host.docker.internal:8080/v1
OPENCLAW_VLM_MODEL=o6-main
# Must not exceed llama-server -c; prompts are trimmed to fit it.
OPENCLAW_MODEL_CONTEXT_TOKENS=16384
OPENCLAW_VLM_CONTEXT_TOKENS=16384
# CPU generation is slow: give model calls time, and keep default answers short.
OPENCLAW_REQUEST_TIMEOUT=600
OPENCLAW_MAX_TOKENS=512
# Reading the prompt (~40 tokens/s) is what makes /rag slow here: cap the
# retrieved text it reads. Checked with scripts/rag_budget_eval.py on real
# documents: 1500/400 kept as many answers as no limit (6/20 both, where
# 1200/300 had 5/20), with a ~1,850-token prompt instead of ~12,600.
OPENCLAW_RAG_CONTEXT_TOKENS=1500
OPENCLAW_RAG_PASSAGE_TOKENS=400

# Embeddings and Qdrant on the host.
OPENCLAW_OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENCLAW_QDRANT_BASE_URL=http://host.docker.internal:6333

# Shared services from compose.o6.yaml.
OPENCLAW_WHISPER_ENABLED=true
OPENCLAW_WHISPER_BASE_URL=http://openclaw-whisper:8765
OPENCLAW_TTS_BASE_URL=http://openclaw-tts:8766

# Model work that isn't a reply (English-bot tasks, knowledge digests, night
# reports) runs off-peak and is delivered at its usual time -- on a CPU host
# this matters even more than on the GB10.
OPENCLAW_ENGLISH_BOT_PREPARE_TIME=04:00
OPENCLAW_CRON_PREPARE_WINDOW=04:00-05:30

# Check-ins (docs/CHECKINS.md), e.g. the work log: put worklog.toml in
# profiles/<bot>/workspace/checkins/ and set the owner.
OPENCLAW_CHECKIN_OWNER=
