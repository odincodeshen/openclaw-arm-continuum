OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_TELEGRAM_ALLOWED_CHAT_IDS=
OPENCLAW_CRON_CHAT_IDS=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_RUNTIME_LABEL=DGX Spark

# Docker Compose profile isolation. Keep these defaults for the classic single
# profile layout, or point them at profiles/<name>/... for personal/demo splits.
OPENCLAW_ENV_FILE=.env
OPENCLAW_HOST_WORKSPACE=./workspace
OPENCLAW_HOST_GATEWAY_DATA=./gateway-data

# Boot mode for `bin/openclawctl boot` (e.g. from a systemd unit on reboot):
#   full   - start core services + the vLLM model engine (default)
#   core   - start core only; run `openclawctl start model` when you need the GPU
#   manual - start nothing
# On a shared GB10 / DGX box, "core" keeps Telegram, memory, cron, and doc
# intake online while leaving the GPU free. See docs/RUNTIME_LIFECYCLE.md.
OPENCLAW_BOOT_MODE=full

OPENCLAW_VLLM_MODEL=Qwen/Qwen3.6-27B-FP8
# Multi-model catalog. If the file is absent, OpenClaw uses
# OPENCLAW_VLLM_BASE_URL / OPENCLAW_VLLM_MODEL as local_default (plus a
# synthesised "vision" entry from OPENCLAW_VLM_*). See app/models.example.json
# and docs/MODEL_ROUTING.md. Roles: general, vision, classification,
# code_review, architecture_review, synthesis.
OPENCLAW_MODEL_CATALOG=/app/models.json

# Optional LLM intent classifier. Only active when the catalog defines a
# "local_router" model. Deterministic slash-command and keyword routing
# always runs first and always wins; this only re-routes plain-language
# messages that would otherwise go straight to the chat model.
OPENCLAW_INTENT_ROUTER_ENABLED=true
OPENCLAW_INTENT_ROUTER_MIN_CONFIDENCE=0.6
OPENCLAW_GPU_MEMORY_UTILIZATION=0.70
OPENCLAW_MAX_MODEL_LEN=262144
OPENCLAW_MAX_NUM_SEQS=4
HF_CACHE_DIR=./.cache/huggingface
VLLM_CACHE_DIR=./.cache/vllm

OPENCLAW_SYSTEM_PROMPT=You are OpenClaw, a local-first personal AI assistant running on the user's Arm Continuum local runtime. Answer clearly, practically, and do not reveal hidden reasoning.
# Default language for model-generated answers (chat, /rag, image analysis, web
# summaries, cron). Empty = the model follows the user's language on its own.
# The user can still ask for another language per message. This does NOT change
# OpenClaw's own fixed UI strings (/help, command replies) -- those stay English.
# Examples: "Traditional Chinese (繁體中文)", "Japanese", "English".
OPENCLAW_REPLY_LANGUAGE=
OPENCLAW_MAX_REPLY_CHARS=3500
OPENCLAW_MAX_TOKENS=160
OPENCLAW_REQUEST_TIMEOUT=150
OPENCLAW_POLL_TIMEOUT=30

OPENCLAW_WEB_ENABLED=true
OPENCLAW_WEB_TIMEOUT=20
OPENCLAW_SCRAPER_BASE_URL=http://openclaw-browser-scraper:8787
OPENCLAW_SCRAPER_LIMIT=3
OPENCLAW_WEB_CONTEXT_CHARS=6000
# Optional fallback for weather questions that do not name a location.
OPENCLAW_DEFAULT_WEATHER_LOCATION=

OPENCLAW_VISION_ENABLED=true
OPENCLAW_VISION_MAX_TOKENS=500

# Vision model. If your main model is already multimodal (the GB10 default,
# Qwen3.x, and the Qwen2.5-VL / Qwen3-VL families are), the simplest setup is
# to point "vision" at that same endpoint -- set OPENCLAW_VLM_BASE_URL /
# OPENCLAW_VLM_MODEL to the main model so it is a deliberate choice. Verify
# with `python scripts/vision_smoke.py` (see docs/VISION_SETUP.md).
#
# For a dedicated VLM (text-only main model, or a specialist for a weak spot):
#  1. models.json (preferred): add a model with role "vision". See
#     app/models.example.json -- same catalog as the router / specialist models.
#  2. OPENCLAW_VLM_* vars: a shortcut that synthesises a "vision" catalog
#     entry when models.json has none. Empty = fall back to the main model.
#  3. Optional second vLLM on the same GPU:
#     docker compose --profile vision up -d openclaw-vllm-vision
# Any OpenAI-compatible /chat/completions server works.
OPENCLAW_VLM_BASE_URL=
OPENCLAW_VLM_MODEL=
OPENCLAW_VLM_MAX_TOKENS=
# Optional second vLLM for the `vision` compose profile.
OPENCLAW_VLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OPENCLAW_VLM_VISION_GPU_MEMORY_UTILIZATION=0.20
OPENCLAW_VLM_VISION_MAX_MODEL_LEN=32768

# Category RAG: photo/document + a category label -> its own Qdrant collection
# so unrelated material never cross-matches. Query with /rag #<name> or #all.
OPENCLAW_CATEGORY_RAG_ENABLED=true
OPENCLAW_CATEGORY_COLLECTION_PREFIX=oc_cat_
OPENCLAW_CATEGORY_INBOX_DIRNAME=categories
OPENCLAW_CATEGORY_REGISTRY_PATH=/workspace/inbox/.openclaw/categories.json
OPENCLAW_CATEGORY_PENDING_TTL_SECONDS=600
# Plain /rag (no #<category>) also searches every category, 3 hits each.
OPENCLAW_RAG_INCLUDE_CATEGORIES=true
OPENCLAW_CATEGORY_MAX_NAME_CHARS=40
OPENCLAW_CATEGORY_IMAGE_MAX_TOKENS=600

# /mem digest reminder thresholds. See docs/TRACKER_MEMORY.md.
OPENCLAW_MEM_DIGEST_DUE_SOON_DAYS=7
OPENCLAW_MEM_DIGEST_STALE_DAYS=14
OPENCLAW_MEM_DIGEST_REMIND_COOLDOWN_DAYS=7

OPENCLAW_WHISPER_ENABLED=true
OPENCLAW_WHISPER_BASE_URL=http://openclaw-whisper:8765
OPENCLAW_WHISPER_TIMEOUT=180
OPENCLAW_WHISPER_MODEL=base

OPENCLAW_MEMORY_ENABLED=true
OPENCLAW_OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENCLAW_EMBEDDING_MODEL=nomic-embed-text:latest
OPENCLAW_EMBEDDING_VECTOR_SIZE=768
OPENCLAW_QDRANT_BASE_URL=http://host.docker.internal:6333
OPENCLAW_TRACKER_COLLECTION=personal_tracker_memory
OPENCLAW_KNOWLEDGE_COLLECTION=personal_knowledge_base
OPENCLAW_RETRIEVAL_LIMIT=5
# How much retrieved text a /rag answer reads, in estimated tokens; 0 = all of
# it. On a CPU-only model reading the prompt is what makes /rag slow, so cap
# it there (docs/O6_SETUP.md). Each passage is cut to its part closest to the
# question, then the best-scoring passages are kept up to the total.
OPENCLAW_RAG_CONTEXT_TOKENS=0
OPENCLAW_RAG_PASSAGE_TOKENS=0
# Keep only retrieved passages scoring within this margin of the best one
# (0 = keep all). Plain /rag takes a few hits from every category; this
# drops the unrelated ones. 0.10 lost no answers in scripts/rag_retrieval_eval.py.
OPENCLAW_RAG_RELEVANCE_MARGIN=0.10
OPENCLAW_INBOX_PATH=/workspace/inbox
OPENCLAW_WATCHER_STATE_PATH=/workspace/.openclaw/watcher_state.json
OPENCLAW_WATCHER_POLL_SECONDS=10
OPENCLAW_INGEST_CHUNK_CHARS=1800
OPENCLAW_INGEST_CHUNK_OVERLAP=200

OPENCLAW_CRON_ENABLED=true
# Use an IANA timezone such as Europe/London, America/New_York, or Asia/Singapore.
OPENCLAW_CRON_TIMEZONE=UTC
OPENCLAW_CRON_POLL_SECONDS=30
OPENCLAW_CRON_DUE_WINDOW_MINUTES=15
# Off-peak preparation (e.g. cheap overnight electricity): daily /cron jobs due
# later today whose prompt starts with one of these prefixes are generated in
# this window and still delivered at their own time. Empty = off.
OPENCLAW_CRON_PREPARE_WINDOW=
OPENCLAW_CRON_PREPARE_PROMPTS=/rag digest

# Operator alerts on Telegram: a failed /cron job, the Gateway unreachable for
# a while, a failed off-peak preparation or English-bot push, files the memory
# watcher can't index. Empty = off. The same problem alerts at most once per
# cooldown; a "recovered" message follows when it clears.
OPENCLAW_ALERT_CHAT_IDS=
OPENCLAW_ALERT_COOLDOWN_MINUTES=360
OPENCLAW_ALERT_GATEWAY_OUTAGE_MINUTES=10
OPENCLAW_CRON_JOBS_PATH=/workspace/.openclaw/cron_jobs.json
OPENCLAW_CRON_STATE_PATH=/workspace/.openclaw/cron_state.json
OPENCLAW_TASK_HISTORY_PATH=/workspace/.openclaw/task_history.jsonl

# Conversational memory for ordinary chat (not /rag, /search, /mem -- those stay
# single-shot). Keeps the last N exchanges per chat so follow-up questions work
# without repeating context. Stored locally per chat_id, never promoted to
# Qdrant. Users clear it with /new. Set ENABLED=false for strict single-turn.
OPENCLAW_CONVERSATION_MEMORY_ENABLED=true
OPENCLAW_CONVERSATION_STORE_PATH=/workspace/.openclaw/conversations
OPENCLAW_CONVERSATION_HISTORY_TURNS=6
OPENCLAW_CONVERSATION_CONTEXT_CHARS=6000
OPENCLAW_CONVERSATION_RETENTION_HOURS=72
# Turns rolling out of the window are folded into a running summary (one
# extra LLM call, only when the window actually overflows) instead of being
# dropped. Set ENABLED=false to skip that call and just drop, like before.
OPENCLAW_CONVERSATION_SUMMARY_ENABLED=true
OPENCLAW_CONVERSATION_SUMMARY_MAX_TOKENS=200
OPENCLAW_CONVERSATION_SUMMARY_MAX_CHARS=2000
# /keep pins a fact so it always rides along regardless of window size.
OPENCLAW_CONVERSATION_KEEP_MAX_ITEMS=20

OPENCLAW_GATEWAY_RPC_URL=http://openclaw-gateway:18789/api/v1/admin/rpc
OPENCLAW_GATEWAY_STATE_DB=/gateway-state/openclaw.sqlite

# English-learning coach bot (daily task push + reply evaluation), off by
# default -- see docs/ENGLISH_BOT.md.
OPENCLAW_ENGLISH_BOT_ENABLED=false
OPENCLAW_ENGLISH_BOT_OWNERS=
OPENCLAW_ENGLISH_BOT_PUSH_TIME=07:15
OPENCLAW_ENGLISH_BOT_SWEEP_TIME=21:00
OPENCLAW_ENGLISH_BOT_TIMEZONE=Europe/London
OPENCLAW_ENGLISH_BOT_STATE_PATH=/workspace/.openclaw/english_bot_state.json
# Generate the day's task off-peak (e.g. 04:00) and deliver it at PUSH_TIME.
# Empty = generate at push time.
OPENCLAW_ENGLISH_BOT_PREPARE_TIME=

# Word lookup (/w) and personal word list (/vocab) for an English-learning
# bot. Off by default. Needs the offline dictionary file built once with
# scripts/build_dictionary.py -- see docs/DICTIONARY.md.
OPENCLAW_DICTIONARY_ENABLED=false
OPENCLAW_DICTIONARY_PATH=/workspace/dictionary/ecdict.sqlite
# 🔊 UK / US pronunciation buttons (needs the openclaw-tts service) -- see docs/DICTIONARY.md.
OPENCLAW_TTS_ENABLED=false

# Daily cleanup of short-lived files (voice messages, old weekly audio, sent
# exports, never-filed uploads) -- see docs/RUNTIME_LIFECYCLE.md. Empty = off.
OPENCLAW_HOUSEKEEPING_TIME=03:30
OPENCLAW_AUDIO_RETENTION_DAYS=14

# Image text: verbatim transcription length, indexing photos that aren't
# filed into a category, and reading scanned PDF pages (0 = off).
OPENCLAW_IMAGE_OCR_MAX_TOKENS=4096
OPENCLAW_INDEX_CHAT_PHOTOS=true
OPENCLAW_PDF_OCR_MAX_PAGES=40

# The model server's context window in tokens (llama.cpp -c); prompts are
# trimmed to fit. 0 = don't trim (vLLM on the GB10). See .env.o6.example.
OPENCLAW_MODEL_CONTEXT_TOKENS=0
OPENCLAW_VLM_CONTEXT_TOKENS=0

# Night ritual: a four-question wind-down journal for one person, with
# reminders, a morning "first thing" card and weekly/monthly reports.
# See docs/NIGHT_RITUAL.md for the other OPENCLAW_NIGHT_RITUAL_* settings.
OPENCLAW_NIGHT_RITUAL_ENABLED=false
OPENCLAW_NIGHT_RITUAL_OWNER=
# Another bot's tracker collection for "Add to tomorrow's schedule" (empty = this bot's).
OPENCLAW_NIGHT_RITUAL_SCHEDULE_COLLECTION=

# Check-ins from TOML files (docs/CHECKINS.md): where the bot reads them,
# where answers are kept, and the owner's chat ID (a file's owner_env).
OPENCLAW_CHECKIN_DIR=/workspace/checkins
OPENCLAW_CHECKIN_DATA_DIR=/workspace/.openclaw/checkins
OPENCLAW_CHECKIN_OWNER=
